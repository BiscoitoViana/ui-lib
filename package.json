{
  "name": "@biscoitoviana/ui-lib",
  "version": "0.1.0",
  "description": "Accessible React component library built with Radix, Tailwind CSS and TypeScript.",
  "author": "Wallace Viana (https://github.com/BiscoitoViana)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BiscoitoViana/ui-lib.git"
  },
  "homepage": "https://github.com/BiscoitoViana/ui-lib#readme",
  "bugs": {
    "url": "https://github.com/BiscoitoViana/ui-lib/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "tailwindcss",
    "radix-ui"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1"
  }
}
